POSTGRES_DB=oyla
POSTGRES_USER=oyla
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# Generate independent high-entropy values; do not commit the resulting .env file.
JWT_SECRET=replace-with-at-least-64-random-characters
OYLA_SECRET_PEPPER=replace-with-a-separate-random-secret
# Separate AES-256 key for external CRM API credentials (base64-encoded 32 random bytes).
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
JWT_ISSUER=oyla-server
JWT_AUDIENCE=oyla-web
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ACTIVATION_CODE_TTL_MINUTES=10
DEVICE_ONLINE_WINDOW_SECONDS=90
