POSTGRES_DB=oyla
POSTGRES_USER=oyla
OYLA_ENV=production
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
OYLA_SECRET_PEPPER=replace-with-a-different-at-least-32-random-characters
# Independent AES-256 key, base64-encoded 32 random bytes. Never reuse JWT_SECRET or OYLA_SECRET_PEPPER.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
JWT_ISSUER=oyla-server
JWT_AUDIENCE=oyla-web
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ACTIVATION_CODE_TTL_MINUTES=10
DEVICE_ONLINE_WINDOW_SECONDS=90
OYLA_COOKIE_SECURE=true
ALLOW_PUBLIC_REGISTRATION=false
OYLA_DOMAIN=oyla.saadsarbas.tech
BCRYPT_LOG_ROUNDS=12
